
import javax.swing.*;
import java.awt.*;

public class ArbolGenealogico extends JPanel {

    public ArbolGenealogico() {
        setPreferredSize(new Dimension(950, 480));
        setBackground(Color.WHITE);
    }

    private void cuadro(Graphics2D g, int x, int y,
                        int ancho, int alto, String texto,
                        Color fondo) {

        g.setColor(fondo);
        g.fillRoundRect(x, y, ancho, alto, 15, 15);

        g.setColor(new Color(90, 130, 160));
        g.drawRoundRect(x, y, ancho, alto, 15, 15);

        g.setColor(Color.BLACK);
        g.setFont(new Font("Arial", Font.BOLD, 12));

        FontMetrics fm = g.getFontMetrics();
        int tx = x + (ancho - fm.stringWidth(texto)) / 2;
        int ty = y + (alto + fm.getAscent()) / 2 - 3;

        g.drawString(texto, tx, ty);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(
            RenderingHints.KEY_ANTIALIASING,
            RenderingHints.VALUE_ANTIALIAS_ON
        );

        Color azul = new Color(210, 230, 248);
        Color verde = new Color(215, 240, 220);
        Color oscuro = new Color(36, 78, 112);

        g2.setStroke(new BasicStroke(2));
        g2.setColor(new Color(110, 150, 175));

        // Lineas del arbol
        g2.drawLine(475, 65, 475, 100);
        g2.drawLine(240, 100, 710, 100);
        g2.drawLine(240, 100, 240, 130);
        g2.drawLine(710, 100, 710, 130);

        g2.drawLine(240, 175, 240, 215);
        g2.drawLine(710, 175, 710, 215);

        g2.drawLine(90, 215, 390, 215);
        g2.drawLine(560, 215, 860, 215);

        g2.drawLine(90, 215, 90, 250);
        g2.drawLine(390, 215, 390, 250);
        g2.drawLine(560, 215, 560, 250);
        g2.drawLine(860, 215, 860, 250);

        // Familia paterna
        cuadro(g2, 385, 20, 180, 45,
               "MI FAMILIA", oscuro);

        cuadro(g2, 150, 130, 180, 45,
               "Familia paterna", azul);

        cuadro(g2, 620, 130, 180, 45,
               "Familia materna", verde);

        cuadro(g2, 20, 250, 140, 50,
               "Papa: Hurtado", azul);

        cuadro(g2, 320, 250, 140, 50,
               "Henry Camilo", azul);

        cuadro(g2, 285, 325, 210, 45,
               "Hurtado Gongora", oscuro);

        // Familia materna: hermanos
        cuadro(g2, 490, 250, 140, 50,
               "Juan David", verde);

        cuadro(g2, 635, 250, 140, 50,
               "Andres Felipe", verde);

        cuadro(g2, 780, 250, 140, 50,
               "Santiago", verde);

        cuadro(g2, 545, 345, 140, 50,
               "Valentina", verde);

        cuadro(g2, 710, 345, 140, 50,
               "Mariana", verde);

        g2.setColor(Color.DARK_GRAY);
        g2.setFont(new Font("Arial", Font.PLAIN, 12));
        g2.drawString("3 hermanos y 2 hermanas por parte materna",
                      290, 430);
    }

    public static void main(String[] args) {
        JFrame ventana = new JFrame("Arbol genealogico familiar");

        ventana.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        ventana.add(new ArbolGenealogico());
        ventana.pack();
        ventana.setLocationRelativeTo(null);
        ventana.setVisible(true);
    }
}
